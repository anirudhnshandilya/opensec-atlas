{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensec-atlas.org/schemas/technology.schema.json",
  "title": "OpenSec Atlas Technology",
  "description": "Schema for an emerging technology documented in OpenSec Atlas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "description",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TECH-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "category": {
      "type": "string",
      "minLength": 2
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "status": {
      "type": "string",
      "enum": [
        "emerging",
        "active",
        "mature",
        "deprecated"
      ]
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "uniqueItems": true
    },
    "related_threats": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^THREAT-[A-Z0-9-]+$"
      },
      "uniqueItems": true
    }
  }
}